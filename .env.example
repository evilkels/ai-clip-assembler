# AI Clip Assembler — Environment Configuration

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# AI Harnesses
# Claude Code
CLAUDE_API_KEY=sk-ant-...

# OpenAI / Codex
OPENAI_API_KEY=sk-...

# Pi Agent (default AI harness)
# Drives the `pi` coding-agent CLI in non-interactive mode for clip scoring.
# Credentials are managed by pi itself (`pi /login`, ~/.pi/agent/auth.json, or
# provider env vars such as OPENCODE_API_KEY) — no key is set here.
PI_BIN=pi
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.4-mini
PI_TIMEOUT_SEC=180

# Local Models (Ollama) — POSTPONED: the local-model path is not fully figured
# out yet, so the local_qwen harness is disabled. These remain for future use.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# FFmpeg
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# Export
EXPORT_DIR=~/Desktop/AI-Clip-Assembler-Exports
