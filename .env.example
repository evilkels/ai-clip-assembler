# AI Clip Assembler — Environment Configuration
#
# Copy to .env (repo root). The backend loads it on startup via python-dotenv.
# Every variable here is read by code; defaults shown are the code defaults,
# so an empty .env is also valid.

# Pi Agent (default AI harness)
# Drives the `pi` coding-agent CLI in non-interactive mode for clip scoring.
# Credentials are managed by pi itself (`pi /login`, ~/.pi/agent/auth.json, or
# provider env vars such as OPENCODE_API_KEY) — no key is set here.
PI_BIN=pi
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.4-mini
PI_TIMEOUT_SEC=180

# Local Models (Ollama) — POSTPONED: the local-model path is not fully figured
# out yet, so the local_qwen harness is disabled. These remain for future use.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TEMPERATURE=0.2

# Frontend (Electron) — read from the shell that launches `npm run dev`,
# not from this file. Override only if the backend runs on a non-default port.
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Note: ffmpeg/ffprobe are resolved from PATH, not configured here. The
# backend port is fixed at 8000 by the uvicorn launch command and the
# frontend default; there are no BACKEND_HOST/BACKEND_PORT variables.
