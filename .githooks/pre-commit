#!/bin/sh

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

staged_paths=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR) || exit 1
ts_paths=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD) || exit 1
eslint_paths=
ruff_paths=
has_frontend_tsx=false
old_ifs=$IFS
IFS=$(printf '\n_')
IFS=${IFS%_}
set -f
has_frontend_ts=false
has_plans=false

for path in $staged_paths; do
  case "$path" in
    frontend/src/*)
      case "$path" in
        *.js|*.mjs|*.ts|*.tsx) ;;
        *) continue ;;
      esac
      if ! git diff --quiet -- "$path"; then
        printf 'pre-commit: %s has unstaged changes; stage or discard them first.\n' "$path" >&2
        exit 1
      fi
      case "$path" in
        frontend/src/renderer/src/types/generated.ts) continue ;;
      esac
      eslint_paths="${eslint_paths}${path}${IFS}"
      case "$path" in
        *.tsx) has_frontend_tsx=true ;;
      esac
      ;;
    backend/*.py)
      if ! git diff --quiet -- "$path"; then
        printf 'pre-commit: %s has unstaged changes; stage or discard them first.\n' "$path" >&2
        exit 1
      fi
      ruff_paths="${ruff_paths}${path}${IFS}"
      ;;
  esac
done

for path in $ts_paths; do
  case "$path" in
    frontend/*.ts|frontend/*.tsx|frontend/*.mts|frontend/*.cts) has_frontend_ts=true ;;
    docs/plans/*) has_plans=true ;;
  esac
done

failed=false

if [ -n "$eslint_paths" ]; then
  if [ ! -x frontend/node_modules/.bin/eslint ]; then
    printf 'pre-commit: missing ESLint; run npm ci in frontend.\n' >&2
    exit 1
  fi
  set --
  # Split the newline-delimited path list; globbing is disabled above.
  # shellcheck disable=SC2086
  [ -n "$eslint_paths" ] && set -- $eslint_paths
  frontend/node_modules/.bin/eslint "$@" --max-warnings=0 || failed=true
fi

if [ "$has_frontend_tsx" = true ]; then
  if [ ! -x frontend/node_modules/.bin/react-doctor ]; then
    printf 'pre-commit: missing react-doctor; run npm ci in frontend.\n' >&2
    exit 1
  fi
  # react-doctor prints a score banner even when clean; show it only on failure.
  if ! doctor_output=$(cd frontend && ./node_modules/.bin/react-doctor --staged --fail-on warning 2>&1); then
    printf '%s\n' "$doctor_output"
    failed=true
  fi
fi

if [ "$has_frontend_ts" = true ]; then
  if [ ! -x frontend/node_modules/.bin/tsc ]; then
    printf 'pre-commit: missing TypeScript compiler; run npm ci in frontend.\n' >&2
    exit 1
  fi
  (cd frontend && ./node_modules/.bin/tsc --noEmit -p tsconfig.json) || failed=true
fi

if [ -n "$ruff_paths" ]; then
  if [ ! -x backend/.venv/bin/ruff ]; then
    printf 'pre-commit: missing Ruff; create backend/.venv and install backend requirements.\n' >&2
    exit 1
  fi
  set --
  # shellcheck disable=SC2086
  [ -n "$ruff_paths" ] && set -- $ruff_paths
  backend/.venv/bin/ruff check --no-cache "$@" || failed=true
fi

if [ "$has_plans" = true ]; then
  # plans.py reads the working tree, so it checks the staged plans only when
  # nothing under docs/plans/ is left unstaged.
  if ! git diff --quiet -- docs/plans || [ -n "$(git ls-files --others --exclude-standard -- docs/plans)" ]; then
    printf 'pre-commit: docs/plans/ has unstaged changes; stage or discard them first.\n' >&2
    exit 1
  fi
  python3 scripts/plans.py check || failed=true
fi

IFS=$old_ifs
[ "$failed" = false ]
