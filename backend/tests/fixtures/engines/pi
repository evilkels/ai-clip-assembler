#!/usr/bin/env python3
import json
import os
import re
import sys
import time
from pathlib import Path

if "--version" in sys.argv:
    print("1.0.0")
    raise SystemExit(0)

log_path = os.environ.get("ACA_FAKE_ENGINE_LOG")
call_number = 0
if log_path and Path(log_path).exists():
    call_number = len(Path(log_path).read_text().splitlines())
scenario = os.environ.get("ACA_FAKE_ENGINE", "ok").split(",")
scenario = scenario[min(call_number, len(scenario) - 1)]
opened = []
for arg in sys.argv[1:]:
    if arg.startswith("@"):
        path = Path(arg[1:]).resolve()
        path.read_bytes()
        opened.append(str(path))

if log_path:
    record = {
        "argv": sys.argv[1:], "cwd": os.getcwd(),
        "cwd_listing": sorted(os.listdir(".")), "env_keys": sorted(os.environ),
        "env": dict(os.environ),
        "stdin": sys.stdin.buffer.read().decode("latin-1"), "opened": opened,
    }
    with open(log_path, "a", encoding="utf-8") as log:
        log.write(json.dumps(record) + "\n")

if scenario == "hang":
    time.sleep(3600)
elif scenario in {"signed_out", "usage_limit", "rate_limited", "network"}:
    messages = {
        "signed_out": "No API key found for openai-codex.\n\nUse /login to log into a provider via OAuth or API key.",
        "usage_limit": "You have hit your ChatGPT usage limit (plus plan). Try again in ~42 min.",
        "rate_limited": "Codex error: rate_limit_exceeded: Too many requests. Server requested 30s retry delay (max: 60s)",
        "network": "fetch failed",
    }
    print(messages[scenario], file=sys.stderr)
    raise SystemExit(1)
elif scenario == "crash":
    print("Segmentation fault", file=sys.stderr)
    raise SystemExit(139)
elif scenario == "garbage" or scenario == "runs_command":
    print("this is not json")
else:
    reply = os.environ.get("ACA_FAKE_REPLY")
    if reply is not None:
        print(reply)
    elif any(re.fullmatch(r"@clip-\d-frame-\d\.jpg", arg) for arg in sys.argv[1:]):
        clips = sorted({int(match.group(1)) for arg in sys.argv[1:] if (match := re.fullmatch(r"@clip-(\d)-frame-\d\.jpg", arg))})
        print(json.dumps({"scores": [{"k": clip, "visual_interest": 7, "reason": "fake"} for clip in clips]}))
    else:
        print('{"message": "OK", "operations": []}')
