{
  "name": "ai-clip-assembler",
  "version": "0.1.0",
  "description": "Local-first AI video editor — Electron + React frontend",
  "author": "Elvijs Ernests Viļķels",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:with-backend": "concurrently -k -n backend,app -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "dev:backend": "cd ../backend && PYTHONPATH=. .venv/bin/uvicorn src.api:app --reload --port 8000",
    "test:backend": "cd ../backend && PYTHONPATH=. .venv/bin/python -m pytest --ignore=tests/test_codex_cli_harness.py",
    "build": "npm run typecheck && electron-vite build && npm run copy:assets",
    "copy:assets": "node -e \"const{join}=require('node:path');const{cpSync}=require('node:fs');cpSync('build',join('out','renderer','build'),{recursive:true});\"",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:backend": "cd ../backend && .venv/bin/ruff check src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "react-doctor": "^0.2.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.0.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.evilkels.ai-clip-assembler",
    "productName": "AI Clip Assembler",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    }
  }
}
