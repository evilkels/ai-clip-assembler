{
  "name": "ai-clip-assembler",
  "version": "0.1.4",
  "description": "Local-first AI video editor — Electron + React frontend",
  "author": "Elvijs Ernests Viļķels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evilkels/ai-clip-assembler.git",
    "directory": "frontend"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run stage:assets && electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:with-backend": "concurrently -k -n backend,app -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "dev:backend": "cd ../backend && PYTHONPATH=. .venv/bin/uvicorn src.api:app --reload --port 8000",
    "test:backend": "cd ../backend && PYTHONPATH=. .venv/bin/python -m pytest --ignore=tests/test_codex_cli_harness.py",
    "build": "npm run typecheck && npm run stage:assets && electron-vite build && npm run copy:assets",
    "build:backend": "cd ../backend && python3 -m pip install -r requirements.txt pyinstaller && python3 -m PyInstaller --noconfirm packaging/backend.spec",
    "stage:assets": "node scripts/stage-assets.mjs",
    "stage:runtime-tools": "node scripts/stage-runtime-tools.mjs",
    "copy:assets": "npm run stage:assets",
    "preview": "npm run stage:assets && electron-vite preview",
    "start": "npm run preview",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint . --max-warnings=0 --ignore-pattern src/renderer/src/types/generated.ts",
    "lint:backend": "cd ../backend && .venv/bin/ruff check src tests",
    "gen:types": "cd ../backend && PYTHONPATH=. .venv/bin/pydantic2ts --module src.models --output ../frontend/src/renderer/src/types/generated.ts --json2ts-cmd \"$(pwd)/../frontend/node_modules/.bin/json2ts\"",
    "check:types-fresh": "tmp=$(mktemp) && cd ../backend && PYTHONPATH=. .venv/bin/pydantic2ts --module src.models --output \"$tmp\" --json2ts-cmd \"$(pwd)/../frontend/node_modules/.bin/json2ts\" && diff -u ../frontend/src/renderer/src/types/generated.ts \"$tmp\" && rm \"$tmp\"",
    "typecheck": "npm run check:types-fresh && tsc --noEmit -p tsconfig.json",
    "test:main": "tsc -p tsconfig.main-tests.json && node --test .tmp/main-tests/tests/main/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build:backend && npm run build && electron-builder",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "react-doctor": "^0.2.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.0.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.evilkels.ai-clip-assembler",
    "productName": "AI Clip Assembler",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/runtime-tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist/ai-clip-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
